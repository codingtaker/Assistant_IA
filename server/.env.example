# Server configuration
PORT=3001
NODE_ENV=development

# AI Providers — fill in at least one
OPENAI_API_KEY=sk-proj-...
ANTHROPIC_API_KEY=sk-ant-...

# Default AI provider: any registered provider id ("openai", "anthropic", or an extra one below)
DEFAULT_AI_PROVIDER=openai

# Default model per built-in provider
OPENAI_MODEL=gpt-4o
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# ---------------------------------------------------------------------------
# Extra OpenAI-compatible providers (RodiumAI, Groq, OpenRouter, xAI, Together,
# Mistral La Plateforme, DeepSeek, Fireworks, Ollama, LM Studio, vLLM, …)
#
# For each ID listed in EXTRA_PROVIDERS, define <ID>_API_KEY, <ID>_BASE_URL and
# <ID>_MODEL (upper-cased, non-alphanumeric chars → "_"). Optional custom HTTP
# headers can be provided via <ID>_HEADERS="Header1: value, Header2: value".
#
# Once configured, the client can request them via `provider: "<id>"` on
# /api/pitch/generate, and they participate in the automatic fallback chain.
# ---------------------------------------------------------------------------
# EXTRA_PROVIDERS=rodium,groq,openrouter

# RodiumAI (https://api.rodiumai.io/v1)
# RODIUM_API_KEY=rd_sk_prod_...
# RODIUM_BASE_URL=https://api.rodiumai.io/v1
# RODIUM_MODEL=anthropic/claude-opus-4-7

# Groq
# GROQ_API_KEY=gsk_...
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# GROQ_MODEL=llama-3.3-70b-versatile

# OpenRouter (needs extra headers for attribution)
# OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_MODEL=anthropic/claude-3.5-sonnet
# OPENROUTER_HEADERS=HTTP-Referer: http://localhost:5173, X-Title: StartupPitch AI

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=20

# CORS — comma-separated allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
