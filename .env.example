# Frontend environment variables
# Copy this file to .env.local and fill in your values

# Backend API URL (default: local dev server)
VITE_API_URL=http://localhost:3001/api

# API key sent as x-api-key. Create one with:  cd server && npm run client:create -- "Web app"
# NOTE: this value is embedded in the built bundle and is publicly visible — it is
# a soft gate + quota handle, not a hard secret. Real per-user auth = login step.
VITE_API_KEY=sp_live_...

# App config
VITE_APP_NAME=StartupPitch AI
VITE_APP_VERSION=2.0.0
