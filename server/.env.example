# Server configuration
PORT=3001
NODE_ENV=development

# Neon Postgres connection string (auth + quota). Get it from the Neon dashboard.
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require

# AI Providers — fill in at least one
OPENAI_API_KEY=sk-proj-...
ANTHROPIC_API_KEY=sk-ant-...

# Default AI provider: any registered provider id ("openai", "anthropic", or an extra one below)
DEFAULT_AI_PROVIDER=openai

# Default model per built-in provider
OPENAI_MODEL=gpt-4o
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# ---------------------------------------------------------------------------
# Extra providers
#
# Presets ship with sensible defaults for known providers (baseURL + model).
# For a preset provider you only need to set <ID>_API_KEY. Anything can be
# overridden with <ID>_BASE_URL / <ID>_MODEL / <ID>_HEADERS.
#
# Supported presets: openai, anthropic, rodium, groq, gemini, openrouter, xai,
# deepseek, mistral, together, fireworks, ollama.
#
# For an ID that has no preset, you must provide all three: <ID>_API_KEY,
# <ID>_BASE_URL and <ID>_MODEL. Optional custom HTTP headers can be provided
# via <ID>_HEADERS="Header1: value, Header2: value".
#
# Once configured, the client can request them via `provider: "<id>"` on
# /api/pitch/generate, and they participate in the automatic fallback chain.
# ---------------------------------------------------------------------------
# EXTRA_PROVIDERS=rodium,groq,openrouter

# Optional: control the exact fallback order (defaults to registration order).
# Only IDs that resolve to *available* providers are kept.
# PROVIDER_FALLBACK_ORDER=rodium,openai,anthropic,groq

# RodiumAI (preset)
# RODIUM_API_KEY=rd_sk_prod_...
# RODIUM_MODEL=anthropic/claude-opus-4-7   # optional, overrides preset default

# Groq (preset)
# GROQ_API_KEY=gsk_...
# GROQ_MODEL=llama-3.3-70b-versatile       # optional

# Google Gemini (preset — OpenAI-compatible endpoint)
# GEMINI_API_KEY=AIzaSy...
# GEMINI_MODEL=gemini-2.0-flash             # optional, autres: gemini-1.5-pro, gemini-1.5-flash

# OpenRouter (preset — attribution headers optional but recommended)
# OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_HEADERS=HTTP-Referer: http://localhost:5173, X-Title: StartupPitch AI

# xAI Grok (preset)
# XAI_API_KEY=xai-...
# XAI_MODEL=grok-2-latest

# DeepSeek / Mistral / Together / Fireworks / Ollama (presets)
# DEEPSEEK_API_KEY=...
# MISTRAL_API_KEY=...
# TOGETHER_API_KEY=...
# FIREWORKS_API_KEY=...
# OLLAMA_API_KEY=ollama   # local Ollama accepts any non-empty string

# Custom provider with no preset — must set all three
# EXTRA_PROVIDERS=myllm
# MYLLM_API_KEY=...
# MYLLM_BASE_URL=https://api.example.com/v1
# MYLLM_MODEL=my-model-v1

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=20

# CORS — comma-separated allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# Restrict which providers a CLIENT may request via the `provider` field.
# Comma-separated allow-list. Unset = any configured provider is selectable.
# The server-side automatic fallback chain is unaffected by this setting.
# CLIENT_SELECTABLE_PROVIDERS=openai,groq
