# Frontend environment variables
# Copy this file to .env.local — never commit .env.local

# VITE_API_URL — backend base URL INCLUDING the /api prefix.
#
# LOCAL DEV: leave this COMMENTED OUT (or delete it).
#   The Vite proxy (vite.config.ts) forwards /api → http://127.0.0.1:3001/api
#   automatically, which avoids CORS when accessing via a network IP.
#
# PRODUCTION: uncomment and set your deployed backend URL.
# VITE_API_URL=https://your-backend.railway.app/api

# Optional API key (only needed if server enforces CLIENT_API_KEY)
# VITE_API_KEY=sp_live_...

# App config
VITE_APP_NAME=StartupPitch AI
VITE_APP_VERSION=2.0.0
